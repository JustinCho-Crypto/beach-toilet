# 로컬 개발용. 복사해서 .env.local 로 저장하고 실제 값을 채운다 (.env.local은 gitignore 대상).
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
VITE_KAKAO_JS_KEY=

# Supabase 프로젝트 (제보 공유 백엔드). supabase/schema.sql을 SQL Editor에서 먼저 실행할 것.
# 콘솔 > Project Settings > API > Project URL / anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
